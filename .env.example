# Copiá a .env y ajustá. Usado por docker-compose.
PUBLIC_URL=http://localhost:3000
WEB_PORT=3000

# Modo demo sin Hubmy (login sin credenciales). Seguro por defecto = false; solo
# la demo pública lo pone en true a propósito. NUNCA true en un cliente real.
DEV_LOGIN=false
# Cookie de sesión solo por TLS. En cualquier despliegue con HTTPS (aunque front
# y back compartan dominio vía nginx) debe ser true.
COOKIE_SECURE=false
# SameSite explícito de la cookie ("Lax" | "None" | "Strict"). Vacío ⇒ se deriva
# de COOKIE_SECURE (true⇒None). Mismo-origen (nginx proxya /api,/auth): "Lax".
# Cross-domain (front y back en dominios distintos): "None".
COOKIE_SAMESITE=

# Hubmy (SSO + IA). Vacío ⇒ login SSO e IA devuelven 503; el modo demo sigue.
HUBMY_API_BASE=https://apidev.hubmy.app
HUBMY_APP_ID=
HUBMY_API_KEY=

# Credenciales de MongoDB (compose).
MONGO_USER=huberp
MONGO_PASS=huberp

# Clave M2M de la superficie interna /internal (consola de super-admin/Mornix).
# Vacía ⇒ /internal queda CERRADO (503). La comparten el core y el servicio
# `platform`; usá un valor fuerte y rotable.
PLATFORM_API_KEY=

# --- Consola de plataforma (servicio `platform`) ---------------------------
# Primer operador de Mornix (para entrar la primera vez). Enrola su MFA (TOTP) al
# primer login. Dejá vacío para no crearlo automáticamente.
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_PASSWORD=
# Puerto local de la consola (bind 127.0.0.1; el acceso público va por su subdominio
# vía Nginx Proxy Manager → alias huberp-platform).
PLATFORM_PORT=3100
# Operador demo de la consola (admin@mornix.tech / mornix-demo-2026). SOLO desarrollo.
PLATFORM_DEV_LOGIN=false

# Tasa de cambio (R9). La tasa entra sola: raspado del BCV como fuente primaria,
# API de respaldo si el BCV no responde, y carga manual auditada como último
# recurso. TASA_AUTO=false apaga la obtención automática (entornos sin salida).
TASA_AUTO=true
TASA_URL_BCV=https://www.bcv.org.ve/
TASA_URL_RESPALDO=https://pydolarve.org/api/v1/dollar?page=bcv&monitor=usd
# Ruta a un PEM con el intermedio correcto del BCV (su servidor envía uno que no
# corresponde y ningún cliente puede verificar la cadena). Sin esto la fuente
# primaria falla y se usa el respaldo.
TASA_CA_EXTRA=
