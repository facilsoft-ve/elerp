# Backend HUBERP — variables de entorno (desarrollo).
PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Persistencia: si MONGO_URI está vacío se usa in-memory (efímero).
MONGO_URI=
MONGO_DB=huberp

# Hubmy (SSO + IA). Registrá el callback en Hubmy:
#   callback_url = ${APP_BASE_URL}/auth/hubmy/callback
HUBMY_API_BASE=https://apidev.hubmy.app
HUBMY_APP_ID=
HUBMY_API_KEY=

SESSION_TTL_MIN=1440
SESSION_COOKIE=huberp_session
COOKIE_SECURE=false
DEV_LOGIN=true

# Tasa de cambio (R9): obtención automática una vez al día, con validación del
# valor y cuarentena de variaciones anómalas.
TASA_AUTO=true
TASA_URL_BCV=https://www.bcv.org.ve/
TASA_URL_RESPALDO=https://pydolarve.org/api/v1/dollar?page=bcv&monitor=usd
TASA_URL_MERCADO=
# PEM con el intermedio correcto del BCV (su cadena TLS viene incompleta).
TASA_CA_EXTRA=
